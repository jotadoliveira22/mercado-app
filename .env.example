# Credenciales para el script de backup (npm run backup).
# Copia este archivo a .env y rellena tus datos. El .env NO se sube a Git.

BACKUP_EMAIL=tu-correo@ejemplo.com
BACKUP_PASSWORD=tu-contrasena

# Opcional: exporta los datos de TODOS los usuarios en vez de solo el tuyo.
# Se obtiene en Supabase → Project Settings → API → service_role.
# ⚠️ Esta clave salta las políticas RLS. Nunca la subas a Git ni al navegador.
# SUPABASE_SERVICE_ROLE_KEY=
